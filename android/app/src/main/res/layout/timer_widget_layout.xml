<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_bg"
    android:gravity="center">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="6dp"
            android:src="@mipmap/ic_launcher_round"
            android:contentDescription="App Logo" />

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shutup &amp; Study"
            android:textColor="#333336"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="No Active Session"
        android:textColor="#7E7E82"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/widget_timer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="--:--"
        android:textColor="#333336"
        android:textSize="28sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/widget_control_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center">

        <TextView
            android:id="@+id/widget_btn_play_pause"
            android:layout_width="70dp"
            android:layout_height="30dp"
            android:text="Play"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/widget_bg"
            android:textColor="#065F46"
            android:clickable="true"
            android:focusable="true"/>

        <TextView
            android:id="@+id/widget_btn_reset"
            android:layout_width="70dp"
            android:layout_height="30dp"
            android:text="Reset"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_bg"
            android:textColor="#333336"
            android:clickable="true"
            android:focusable="true"/>

    </LinearLayout>

</LinearLayout>
